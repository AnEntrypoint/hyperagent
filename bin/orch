#!/usr/bin/env python3
from __future__ import annotations

import argparse
import asyncio
import contextlib
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path
from datetime import datetime
from urllib.parse import urlencode

import aiohttp

sys.path.insert(0, str(Path(__file__).resolve().parent))
import journal as output_journal

ROOT = Path(__file__).resolve().parents[1]
ORCH_DIR = Path(os.environ.get("ORCH_HOME") or (ROOT / ".orch")).resolve()
HOST = os.environ.get("ORCH_HOST", "127.0.0.1")
PORT = int(os.environ.get("ORCH_PORT", "8787"))
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")
SESSION_ID_RE = re.compile(r"^[^-\x00\n][^\x00\n]{0,4095}$")
STATE_FILE = ORCH_DIR / "state.json"
STATE_LOCK = ORCH_DIR / "state.lock"
DEFAULT_TIMEOUT = 1800.0
DEFAULT_HARNESS = "claude"
KINDS = "text,tool,you"
TAG = {"t": "text", "u": "tool", "y": "you"}
PROMPT_RETRY_AFTER = 12.0
PROMPT_RETRIES = 2
PARENT = Path(os.environ.get("ORCH_PARENT") or ROOT.parent).resolve()
PROJECT_MARKERS = (
    "AGENTS.md", "CLAUDE.md", "package.json", "pyproject.toml", "setup.py",
    "Cargo.toml", "go.mod", "CMakeLists.txt", "Makefile", "requirements.txt",
    "Gemfile", "composer.json", "pom.xml", "build.gradle", "meson.build", "deno.json",
)
PROJECT_SUFFIXES = (".sln", ".csproj", ".fsproj", ".xcodeproj", ".uproject", ".cabal")
TRUST_TEXT = "Yes, I trust this folder"
TRUST_HINT = "Enter to confirm"


def airc_root() -> Path:
    return Path(os.environ.get("AIRC_DIR") or (ROOT.parent / "airc")).resolve()


def airc_mods():
    root = str(airc_root())
    if root not in sys.path:
        sys.path.insert(0, root)
    import mods

    return mods


def base_url() -> str:
    return f"http://{HOST}:{PORT}"


def ws_url(name: str, cwd: str | None, harness: str, resume: str | None = None,
           continue_last: bool = False, fork: bool = False) -> str:
    query = {"session": name, "harness": harness, "mode": "tagged", "kinds": KINDS}
    if cwd:
        query["cwd"] = cwd
    if resume:
        query["resume"] = resume
    if continue_last:
        query["continue"] = "1"
    if fork and (resume or continue_last):
        query["fork"] = "1"
    return f"ws://{HOST}:{PORT}/ws?{urlencode(query)}"


def check_name(name: str) -> str:
    if not NAME_RE.match(name):
        raise SystemExit(f"bad agent name {name!r}: use letters, digits, underscore, dash")
    return name


def check_harness(harness: str) -> str:
    try:
        known = airc_mods().names()
    except Exception as exc:
        raise SystemExit(f"cannot load airc mods from {airc_root()}: {exc}")
    if harness not in known:
        raise SystemExit(f"unknown harness {harness!r}; known: {', '.join(known)}")
    return harness


def resolve_cwd(cwd: str | None) -> str:
    path = Path(os.path.expanduser(cwd)) if cwd else ROOT
    if not path.is_absolute():
        path = ROOT / path
    return str(path.resolve())


def pane_tail(pane: str, count: int = 10) -> list[str]:
    lines = [line.rstrip() for line in pane.splitlines() if line.strip()]
    return lines[-count:]


def is_busy(harness: str, pane: str) -> bool:
    try:
        return airc_mods().load(harness).pane_busy(pane)
    except Exception:
        return False


async def pane_idle_ready(harness: str, name: str) -> bool:
    pane = await capture(name)
    try:
        mod = airc_mods().load(harness)
    except Exception:
        return False
    return mod.pane_ready(pane) and not mod.pane_busy(pane)


async def capture(name: str) -> str:
    try:
        proc = await asyncio.create_subprocess_exec(
            "tmux", "capture-pane", "-t", f"ccb-{name}", "-p",
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
        out, _ = await proc.communicate()
        return out.decode("utf-8", "replace")
    except Exception:
        return ""


async def press(name: str, *keys: str) -> None:
    try:
        proc = await asyncio.create_subprocess_exec(
            "tmux", "send-keys", "-t", f"ccb-{name}", *keys,
            stdout=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.DEVNULL)
        await proc.wait()
    except Exception:
        pass


async def answer_trust(name: str, timeout: float = 8.0) -> bool:
    started = time.time()
    answered = False
    while time.time() - started < timeout:
        pane = await capture(name)
        dialog = TRUST_TEXT in pane and TRUST_HINT in pane
        if dialog and not answered:
            await press(name, "Down", "Enter")
            answered = True
            await asyncio.sleep(1.5)
            continue
        if answered and not dialog:
            return True
        if not answered and pane.strip() and time.time() - started > 3.0:
            return False
        await asyncio.sleep(0.3)
    return answered


async def hub_exists(name: str) -> bool:
    try:
        info = (await fetch_sessions()).get(name) or {}
        return bool(info.get("alive"))
    except Exception:
        return False


async def server_alive(timeout: float = 1.0) -> bool:
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(base_url() + "/sessions",
                                   timeout=aiohttp.ClientTimeout(total=timeout)) as response:
                return response.status == 200
    except Exception:
        return False


def spawn_server() -> subprocess.Popen:
    server = airc_root() / "server.py"
    if not server.is_file():
        raise SystemExit(f"airc server not found at {server}; set AIRC_DIR")
    ORCH_DIR.mkdir(parents=True, exist_ok=True)
    log = open(ORCH_DIR / "server.log", "ab")
    env = dict(os.environ)
    if os.environ.get("ORCH_SKIP_PERMISSIONS", "1") == "1":
        env["AIRC_CLAUDE_SKIP_PERMISSIONS"] = "1"
    else:
        env.pop("AIRC_CLAUDE_SKIP_PERMISSIONS", None)
    model = os.environ.get("ORCH_CLAUDE_MODEL", "haiku")
    if model:
        env["AIRC_CLAUDE_MODEL"] = model
    else:
        env.pop("AIRC_CLAUDE_MODEL", None)
    proc = subprocess.Popen(
        [sys.executable, str(server), "--host", HOST, "--port", str(PORT)],
        cwd=str(airc_root()), stdout=log, stderr=log, start_new_session=True, env=env)
    (ORCH_DIR / "server.pid").write_text(str(proc.pid))
    return proc


def server_log() -> str:
    path = ORCH_DIR / "server.log"
    if not path.is_file():
        return ""
    return "\n".join(path.read_text(errors="replace").splitlines()[-15:])


async def ensure_server(wait: float = 25.0) -> None:
    if await server_alive():
        return
    proc = spawn_server()
    deadline = time.time() + wait
    while time.time() < deadline:
        if await server_alive(0.5):
            return
        if proc.poll() is not None:
            break
        await asyncio.sleep(0.2)
    raise SystemExit(f"airc server failed on {base_url()}\n{server_log()}")


async def fetch_sessions() -> dict:
    async with aiohttp.ClientSession() as session:
        async with session.get(base_url() + "/sessions",
                               timeout=aiohttp.ClientTimeout(total=10)) as response:
            response.raise_for_status()
            return await response.json()


def read_entries(path: str, key: str | None) -> list[dict]:
    data = json.loads(Path(path).read_text())
    entries = data.get(key) if key and isinstance(data, dict) else data
    if not isinstance(entries, list):
        raise SystemExit(f"{path}: expected a list or an object with a {key!r} list")
    return entries


def normalize(entry: dict, require_prompt: bool) -> dict:
    if not isinstance(entry, dict):
        raise SystemExit(f"bad entry {entry!r}")
    name = check_name(str(entry.get("name") or ""))
    harness = check_harness(str(entry.get("harness") or DEFAULT_HARNESS))
    job = {"name": name, "harness": harness, "harness_explicit": bool(entry.get("harness"))}
    if entry.get("cwd"):
        job["cwd"] = resolve_cwd(entry.get("cwd"))
    prompt = entry.get("prompt")
    if require_prompt and not prompt:
        raise SystemExit(f"entry {name!r} has no prompt")
    if prompt:
        job["prompt"] = str(prompt)
    session_id = entry.get("session_id") or entry.get("resume")
    if session_id:
        job["resume"] = check_session_id(str(session_id))
    if entry.get("continue"):
        if job.get("resume"):
            raise SystemExit(f"entry {name!r}: resume and continue are mutually exclusive")
        job["continue"] = True
    if entry.get("fork"):
        job["fork"] = True
    return job


def safe_name(raw: str) -> str:
    name = re.sub(r"[^A-Za-z0-9_-]+", "-", raw).strip("-")
    return name[:64] or "project"


def check_session_id(session_id: str) -> str:
    if not SESSION_ID_RE.match(session_id):
        raise SystemExit(f"bad session selector {session_id!r}")
    return session_id


def harness_sessions(harness: str, cwd: str) -> list[dict]:
    return airc_mods().load(harness).sessions(cwd)


def latest_session(harness: str, cwd: str) -> dict | None:
    found = harness_sessions(harness, cwd)
    return found[-1] if found else None


def session_from_launch_args(args: list[str] | tuple[str, ...]) -> str | None:
    values = list(args)
    for index, value in enumerate(values):
        if value in ("--resume", "-r", "--session", "resume", "--continue"):
            following = values[index + 1] if index + 1 < len(values) else ""
            if following and not following.startswith("-"):
                return following
    return None


def session_first_stamp(path: str) -> float | None:
    for record in output_journal.iter_records(path):
        stamp = record.get("timestamp")
        if stamp:
            try:
                return datetime.fromisoformat(str(stamp).replace("Z", "+00:00")).timestamp()
            except ValueError:
                return None
    return None


def session_created_after(harness: str, cwd: str, since: float) -> dict | None:
    created = []
    for session in harness_sessions(harness, cwd):
        first = session_first_stamp(session["path"])
        if first is not None and first >= since - 2.0:
            created.append((first, session))
    return min(created, key=lambda pair: pair[0])[1] if created else None


async def resolve_output_session(job: dict, since: float) -> str | None:
    if job.get("resume"):
        return job["resume"]
    try:
        live = (await fetch_sessions()).get(job["name"]) or {}
        found = session_from_launch_args(live.get("launch_args") or [])
        if found:
            return found
    except Exception:
        pass
    session = session_created_after(job["harness"], job["cwd"], since)
    return session["session_id"] if session else None


def read_state() -> dict:
    try:
        data = json.loads(STATE_FILE.read_text())
    except (OSError, ValueError):
        return {"last_project": None, "projects": {}}
    if not isinstance(data, dict):
        return {"last_project": None, "projects": {}}
    if not isinstance(data.get("projects"), dict):
        data["projects"] = {}
    return data


def update_state(change) -> dict:
    STATE_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with open(STATE_LOCK, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = read_state()
        change(state)
        temp = STATE_FILE.with_suffix(".json.tmp")
        temp.write_text(json.dumps(state, indent=2, sort_keys=True))
        os.replace(temp, STATE_FILE)
        fcntl.flock(lock, fcntl.LOCK_UN)
    return state


def record_project(name: str, cwd: str, session_id: str | None = None,
                   harness: str | None = None) -> None:
    def change(state: dict) -> None:
        entry = state["projects"].setdefault(name, {})
        entry["cwd"] = cwd
        entry["touched"] = round(time.time(), 3)
        if harness:
            entry["harness"] = harness
        if session_id:
            entry["session_id"] = session_id
            entry["resumed_at"] = round(time.time(), 3)
        state["last_project"] = name

    update_state(change)


def last_project() -> dict | None:
    projects = read_state()["projects"]
    ordered = sorted(projects.items(), key=lambda pair: pair[1].get("touched", 0),
                     reverse=True)
    for name, entry in ordered:
        if entry.get("cwd"):
            return {"name": name, "cwd": entry["cwd"],
                    "harness": entry.get("harness") or DEFAULT_HARNESS}
    return None


def newest_project() -> dict | None:
    best: dict | None = None
    for project in discover(True):
        for harness in airc_mods().names():
            session = latest_session(harness, project["cwd"])
            if session is None:
                continue
            if best is None or session["mtime"] > best["mtime"]:
                best = {"name": project["name"], "cwd": project["cwd"],
                        "harness": harness, "mtime": session["mtime"]}
    if best is not None:
        best.pop("mtime", None)
    return best


def project_target(project: str | None = None, cwd: str | None = None,
                   harness: str | None = None) -> dict:
    if cwd:
        return {"name": check_name(project or safe_name(Path(cwd).name)),
                "cwd": resolve_cwd(cwd), "harness": harness or DEFAULT_HARNESS}
    if project:
        name = check_name(project)
        known = {item["name"]: item["cwd"] for item in discover(True)}
        entry = read_state()["projects"].get(name) or {}
        location = known.get(name) or entry.get("cwd")
        if not location:
            raise SystemExit(f"unknown project {project!r}; see bin/orch projects")
        return {"name": name, "cwd": resolve_cwd(location),
                "harness": harness or entry.get("harness") or DEFAULT_HARNESS}
    target = last_project() or newest_project()
    if target is None:
        raise SystemExit("no project with a session to resume")
    return {"name": target["name"], "cwd": resolve_cwd(target["cwd"]),
            "harness": harness or target.get("harness") or DEFAULT_HARNESS}


def resume_target(project: str | None = None, session_id: str | None = None,
                  cwd: str | None = None, harness: str | None = None) -> dict:
    target = project_target(project, cwd, harness)
    found = harness_sessions(target["harness"], target["cwd"])
    if session_id:
        selector = check_session_id(session_id)
        chosen = next((item for item in found if item["session_id"] == selector), None)
        if chosen is None:
            adapter = airc_mods().load(target["harness"])
            try:
                kind = adapter.selector_kind(selector)
            except (ValueError, NotImplementedError) as exc:
                raise SystemExit(str(exc))
            if kind == "name":
                chosen = {"session_id": selector, "path": "", "mtime": 0, "size": 0,
                          "selector": kind}
            elif kind == "path":
                try:
                    stat = os.stat(selector)
                except OSError as exc:
                    raise SystemExit(str(exc))
                chosen = {"session_id": selector, "path": selector,
                          "mtime": stat.st_mtime, "size": stat.st_size,
                          "selector": kind}
            else:
                global_session = adapter.find(selector)
                if global_session is not None:
                    chosen = {**global_session, "selector": kind, "global": True}
                else:
                    recent = ", ".join(item["session_id"] for item in found[-5:]) or "(none)"
                    raise SystemExit(f"session {selector!r} not found for {target['cwd']}; "
                                     f"recent: {recent}")
        return {**target, "session": chosen}
    entry = read_state()["projects"].get(target["name"]) or {}
    remembered = entry.get("session_id")
    if remembered:
        chosen = next((item for item in found if item["session_id"] == remembered), None)
        if chosen is None:
            try:
                chosen = airc_mods().load(target["harness"]).find(remembered)
            except (ValueError, NotImplementedError):
                chosen = None
        if chosen is not None:
            return {**target, "session": chosen}
    if not found:
        raise SystemExit(f"no {target['harness']} session transcript for {target['cwd']}")
    return {**target, "session": found[-1]}


async def tmux_alive(name: str) -> bool:
    proc = await asyncio.create_subprocess_exec(
        "tmux", "has-session", "-t", f"ccb-{name}",
        stdout=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.DEVNULL)
    return await proc.wait() == 0


async def peer_present(name: str) -> bool:
    return await hub_exists(name) or await tmux_alive(name)


async def retire(name: str) -> dict:
    stopped_hub = False
    if await server_alive():
        async with aiohttp.ClientSession() as http:
            async with http.delete(base_url() + f"/sessions/{name}",
                                   timeout=aiohttp.ClientTimeout(total=30)) as response:
                stopped_hub = response.status == 200
    proc = await asyncio.create_subprocess_exec(
        "tmux", "kill-session", "-t", f"ccb-{name}",
        stdout=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.DEVNULL)
    killed_tmux = await proc.wait() == 0
    return {"hub": stopped_hub, "tmux": killed_tmux}


def is_project(path: Path) -> bool:
    if (path / ".git").exists():
        return True
    if any((path / marker).exists() for marker in PROJECT_MARKERS):
        return True
    if (path / "src").is_dir():
        return True
    try:
        return any(entry.suffix in PROJECT_SUFFIXES for entry in path.iterdir())
    except OSError:
        return False


def discover(all_dirs: bool) -> list[dict]:
    if not PARENT.is_dir():
        raise SystemExit(f"parent path not found: {PARENT}")
    found: list[dict] = []
    used: set[str] = set()
    for path in sorted(PARENT.iterdir(), key=lambda entry: entry.name.lower()):
        try:
            if not path.is_dir() or path.name.startswith("."):
                continue
            if path.resolve() == ROOT:
                continue
            if not all_dirs and not is_project(path):
                continue
        except OSError:
            continue
        name = safe_name(path.name)
        unique = name
        counter = 2
        while unique in used:
            unique = f"{name}-{counter}"
            counter += 1
        used.add(unique)
        found.append({"name": unique, "cwd": str(path.resolve()), "harness": DEFAULT_HARNESS})
    return found


@contextlib.asynccontextmanager
async def session_lock(name: str, wait: float):
    path = ORCH_DIR / "locks" / f"{name}.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)

    def acquire() -> bool:
        deadline = time.time() + wait
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return True
            except BlockingIOError:
                if time.time() >= deadline:
                    return False
                time.sleep(0.2)

    try:
        if not await asyncio.to_thread(acquire):
            raise SystemExit(f"agent {name!r} is already being prompted")
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


async def read_frames(ws, queue: asyncio.Queue) -> None:
    try:
        async for message in ws:
            if message.type == aiohttp.WSMsgType.TEXT:
                await queue.put(message.data)
            elif message.type in (aiohttp.WSMsgType.CLOSE, aiohttp.WSMsgType.ERROR,
                                  aiohttp.WSMsgType.CLOSED):
                break
    finally:
        await queue.put(None)


async def run_job(job: dict, timeout: float, idle_exit: float, lock_wait: float,
                  tools: bool, trust: bool) -> dict:
    name, harness = job["name"], job["harness"]
    started = time.time()
    writer: output_journal.Journal | None = None
    bound_at = 0.0

    async def write_output(kind: str, text: str = "", **fields) -> None:
        nonlocal writer, bound_at
        if writer is None:
            writer = output_journal.Journal(name, job.get("cwd") or str(ROOT), harness,
                                            job.get("resume"))
        if writer.session_id is None and time.time() - bound_at >= 1.0:
            bound_at = time.time()
            found = await resolve_output_session(job, started)
            if found:
                writer.bind(found)
        writer.append(kind, text, **fields)

    await write_output("instruct", job.get("prompt") or "")
    text_parts: list[str] = []
    final_parts: list[str] = []
    tool_names: list[str] = []
    status = "died"
    acked = False
    tail: list[str] = []
    async with session_lock(name, lock_wait):
        if job.get("resume") or job.get("continue"):
            await retire(name)
        existing = await hub_exists(name)
        async with aiohttp.ClientSession() as http:
            async with http.ws_connect(
                    ws_url(name, job["cwd"], harness, job.get("resume"),
                           bool(job.get("continue")), bool(job.get("fork"))),
                    heartbeat=30, max_msg_size=16 << 20) as ws:
                if trust and not existing and await answer_trust(name):
                    print(f"[orch] {name}: accepted folder trust", file=sys.stderr)
                await ws.send_str(job["prompt"])
                sent = time.time()
                retries = 0
                queue: asyncio.Queue = asyncio.Queue()
                reader = asyncio.create_task(read_frames(ws, queue))
                last = time.time()
                try:
                    while True:
                        remaining = started + timeout - time.time()
                        if remaining <= 0:
                            status = "timeout"
                            break
                        try:
                            frame = await asyncio.wait_for(queue.get(), min(remaining, 5.0))
                        except asyncio.TimeoutError:
                            now = time.time()
                            if (not acked and not text_parts and retries < PROMPT_RETRIES
                                    and now - sent >= PROMPT_RETRY_AFTER
                                    and await pane_idle_ready(harness, name)):
                                await ws.send_str(job["prompt"])
                                sent = now
                                retries += 1
                                last = now
                                continue
                            if idle_exit > 0 and now - last >= idle_exit:
                                pane = await capture(name)
                                if not is_busy(harness, pane):
                                    tail = pane_tail(pane)
                                    status = "blocked"
                                    break
                            continue
                        if frame is None:
                            status = "died"
                            break
                        last = time.time()
                        if frame in ("", "e:"):
                            status = "turn_end" if frame == "e:" else "died"
                            break
                        if len(frame) > 1 and frame[1] == ":" and frame[0] in TAG:
                            kind, payload = TAG[frame[0]], frame[2:]
                            if kind == "text":
                                text_parts.append(payload)
                                final_parts.append(payload)
                                await write_output("text", payload)
                            elif kind == "tool":
                                tool_names.append(payload)
                                final_parts.clear()
                                await write_output("tool", payload)
                            elif kind == "you":
                                acked = True
                                final_parts.clear()
                                await write_output("you", payload)
                        else:
                            text_parts.append(frame)
                            await write_output("raw", frame)
                finally:
                    reader.cancel()
                    with contextlib.suppress(asyncio.CancelledError):
                        await reader
    if status in ("timeout", "blocked"):
        tail = pane_tail(await capture(name))
    if writer is None:
        writer = output_journal.Journal(name, job.get("cwd") or str(ROOT), harness,
                                        job.get("resume"))
    if writer.session_id is None:
        found = await resolve_output_session(job, started)
        if found:
            writer.bind(found)
    writer.append("result", "", status=status, duration_s=round(time.time() - started, 1),
                  acked=acked, pane_tail=tail)
    writer.flush()
    response = "".join(final_parts)
    if not response.strip():
        response = "".join(text_parts)
    result = {"name": name, "harness": harness, "cwd": job["cwd"], "status": status,
              "text": response, "acked": acked, "pane_tail": tail,
              "tool_names": tool_names,
              "duration_s": round(time.time() - started, 1),
              "output_path": str(writer.path),
              "output_session": writer.session_id or writer.fallback_id}
    if job.get("fork") or job.get("record_latest"):
        session = latest_session(harness, job["cwd"])
        if session:
            record_project(name, job["cwd"], session["session_id"], harness)
            key = "forked_session" if job.get("fork") else "resolved_session"
            result[key] = session["session_id"]
    return result


def render_result(result: dict, tools: bool) -> str:
    lines = [f"=== {result['name']} [{result['status']}] {result['duration_s']}s "
             f"harness={result['harness']} cwd={result['cwd']} ==="]
    text = result["text"].strip()
    lines.append(text if text else "(no text)")
    if tools and result.get("tool_names"):
        lines.append("[orch] tools: " + ", ".join(result["tool_names"]))
    if result["status"] != "turn_end":
        if not result["acked"]:
            lines.append("[orch] prompt was not echoed into the transcript")
        if result["pane_tail"]:
            lines.append("[orch] pane tail:")
            lines.extend(f"| {line}" for line in result["pane_tail"])
    if result.get("output_path"):
        lines.append(f"[orch] output {result['output_path']}")
    return "\n".join(lines)


async def cmd_up(args) -> int:
    await ensure_server()
    sessions = await fetch_sessions()
    print(f"airc server up at {base_url()} ({len(sessions)} sessions)")
    return 0


async def cmd_down(args) -> int:
    sessions = await fetch_sessions() if await server_alive() else {}
    pid_file = ORCH_DIR / "server.pid"
    if not pid_file.is_file():
        print(f"no pid file at {pid_file}; server running={bool(sessions)}")
        return 0 if not sessions else 3
    pid = int(pid_file.read_text().strip())
    with contextlib.suppress(ProcessLookupError):
        os.kill(pid, signal.SIGTERM)
    deadline = time.time() + 20
    while time.time() < deadline and await server_alive(0.5):
        await asyncio.sleep(0.2)
    pid_file.unlink(missing_ok=True)
    print(f"stopped airc server pid={pid}; ended {len(sessions)} sessions")
    return 0


async def start_one(job: dict, settle: float, trust: bool,
                     lock_wait: float = DEFAULT_TIMEOUT) -> dict:
    trusted = False
    async with session_lock(job["name"], lock_wait):
        if job.get("resume") or job.get("continue"):
            await retire(job["name"])
        existing = await hub_exists(job["name"])
        async with aiohttp.ClientSession() as http:
            async with http.ws_connect(
                    ws_url(job["name"], job["cwd"], job["harness"], job.get("resume"),
                           bool(job.get("continue")), bool(job.get("fork"))),
                    heartbeat=30) as ws:
                if trust and not existing:
                    trusted = await answer_trust(job["name"])
                await asyncio.sleep(settle)
    result = {**job, "trusted": trusted}
    if job.get("fork") or job.get("record_latest"):
        session = latest_session(job["harness"], job["cwd"])
        if session:
            record_project(job["name"], job["cwd"], session["session_id"], job["harness"])
            key = "forked_session" if job.get("fork") else "resolved_session"
            result[key] = session["session_id"]
    return result


async def cmd_start(args) -> int:
    names = list(dict.fromkeys(args.names))
    if args.fork and not args.resume:
        raise SystemExit("--fork needs --resume")
    if not names:
        print("start needs one or more project names; see `bin/orch projects`", file=sys.stderr)
        return 1
    if args.cwd and len(names) > 1:
        raise SystemExit("--cwd applies to a single name")
    await ensure_server()
    jobs = [normalize({"name": name, "cwd": args.cwd if len(names) == 1 else None,
                       "harness": args.harness}, False) for name in names]
    await fill_cwds(jobs)
    unknown = [job["name"] for job in jobs if not job.get("cwd")]
    if unknown:
        raise SystemExit(f"unknown project(s): {', '.join(unknown)}; "
                         "see bin/orch projects or pass --cwd")
    if args.resume:
        for job in jobs:
            if await peer_present(job["name"]):
                continue
            session = latest_session(job["harness"], job["cwd"])
            if session:
                job["resume"] = session["session_id"]
                if args.fork:
                    job["fork"] = True
    limit = args.concurrency if args.concurrency > 0 else len(jobs)
    gate = asyncio.Semaphore(max(1, limit))

    async def bounded(job: dict) -> dict:
        async with gate:
            return await start_one(job, args.settle, args.trust)

    results = await asyncio.gather(*(bounded(job) for job in jobs))
    sessions = await fetch_sessions()
    failed = 0
    for job in results:
        live = sessions.get(job["name"])
        state = "started" if live and live.get("alive") else "not alive"
        if not live or not live.get("alive"):
            failed += 1
        suffix = " trust=accepted" if job.get("trusted") else ""
        print(f"{job['name']}: {state} harness={job['harness']} "
              f"cwd={job.get('cwd') or ROOT}{suffix}")
    print(f"{len(results) - failed}/{len(results)} peers alive")
    return 0 if failed == 0 else 3


async def cmd_projects(args) -> int:
    jobs = discover(args.all)
    if args.json:
        print(json.dumps(jobs, indent=2))
    else:
        for job in jobs:
            print(f"{job['name']}\t{job['cwd']}")
        print(f"{len(jobs)} projects under {PARENT}", file=sys.stderr)
    return 0


async def cmd_resume(args) -> int:
    prompt = " ".join(args.prompt) if args.prompt else ""
    session_id = check_session_id(args.session) if args.session else None
    target = resume_target(args.name, session_id, args.cwd, args.harness)
    job = {"name": target["name"], "harness": target["harness"], "cwd": target["cwd"],
           "resume": target["session"]["session_id"]}
    if target["session"].get("selector") in ("name", "path"):
        job["record_latest"] = True
    if args.continue_last:
        job.pop("resume", None)
        job["continue"] = True
    if args.fork:
        job["fork"] = True
    if prompt:
        job["prompt"] = prompt
    await fill_cwds([job])
    await ensure_server()
    if (await peer_present(job["name"]) and not session_id and not args.continue_last
            and not args.fork):
        sessions = await fetch_sessions()
        info = sessions.get(job["name"]) or {}
        if not info or info.get("harness") in (None, job["harness"]):
            payload = {"state": "already_alive", "project": job["name"], "cwd": job["cwd"],
                       "harness": job["harness"],
                       "session_id": target["session"]["session_id"],
                       "launch_args": info.get("launch_args") or []}
            print(json.dumps(payload, indent=2) if args.json else
                  f"{job['name']}: already alive cwd={job['cwd']} "
                  f"session={target['session']['session_id']}")
            return 0
    if prompt:
        result = await run_job(job, args.timeout, args.idle_exit, args.lock_wait, args.tools,
                               args.trust)
        await live_cwds([result])
        if args.json:
            print(json.dumps({"session_id": result.get("forked_session")
                              or result.get("resolved_session")
                              or target["session"]["session_id"],
                              "source_session_id": target["session"]["session_id"],
                              "fork": bool(job.get("fork")),
                              "global": bool(target["session"].get("global")),
                              "result": result}, indent=2))
        elif result["status"] == "turn_end":
            print(result["text"].strip())
        else:
            print(render_result(result, args.tools))
        if result["status"] == "turn_end":
            return 0
        return 2 if result["status"] in ("timeout", "blocked") else 3
    started = await start_one(job, args.settle, args.trust)
    sessions = await fetch_sessions()
    info = sessions.get(job["name"]) or {}
    state = "resumed" if info.get("alive") else "not alive"
    payload = {"state": state, "project": job["name"], "cwd": job["cwd"],
               "harness": job["harness"],
               "session_id": started.get("forked_session")
               or started.get("resolved_session")
               or target["session"]["session_id"],
               "source_session_id": target["session"]["session_id"],
               "fork": bool(job.get("fork")),
               "global": bool(target["session"].get("global")),
               "launch_args": info.get("launch_args") or [],
               "trusted": started.get("trusted", False)}
    print(json.dumps(payload, indent=2) if args.json else
          f"{job['name']}: {state} session={target['session']['session_id']} "
          f"launch={payload['launch_args']} cwd={job['cwd']}")
    return 0 if info.get("alive") else 3


async def cmd_sessions(args) -> int:
    if args.all:
        rows = []
        for project in discover(True):
            for harness in airc_mods().names():
                for item in harness_sessions(harness, project["cwd"]):
                    rows.append({"project": project["name"], "cwd": project["cwd"],
                                 "harness": harness, **item})
    else:
        target = project_target(args.name, args.cwd, args.harness)
        rows = [{"project": target["name"], "cwd": target["cwd"],
                 "harness": target["harness"], **item}
                for item in harness_sessions(target["harness"], target["cwd"])]
    if args.json:
        print(json.dumps(rows, indent=2))
    else:
        for row in rows:
            stamp = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(row["mtime"]))
            print(f"{row['project']}\t{row['harness']}\t{row['session_id']}\t{stamp}\t"
                  f"{row['size']}\t{row['path']}")
        print(f"{len(rows)} sessions", file=sys.stderr)
    return 0 if rows else 3


async def cmd_status(args) -> int:
    await ensure_server()
    sessions = await fetch_sessions()
    if args.json:
        print(json.dumps(sessions, indent=2, sort_keys=True))
        return 0
    if not sessions:
        print("no sessions")
        return 0
    for name in sorted(sessions):
        info = sessions[name]
        print(f"{name}  alive={'yes' if info.get('alive') else 'no'} "
              f"busy={'yes' if info.get('busy') else 'no'} "
              f"harness={info.get('harness')} clients={info.get('clients')} cwd={info.get('cwd')}")
        if args.panes:
            for line in info.get("pane_tail") or []:
                print(f"  | {line}")
    return 0


async def fill_cwds(jobs: list[dict]) -> None:
    known = {project["name"]: project["cwd"] for project in discover(True)}
    state_projects = read_state()["projects"]
    remembered = {name: entry["cwd"] for name, entry in state_projects.items()
                  if entry.get("cwd")}
    live: dict = {}
    try:
        live = await fetch_sessions()
    except Exception:
        pass
    for job in jobs:
        if not job.get("cwd"):
            info = live.get(job["name"]) or {}
            job["cwd"] = (info.get("cwd") or known.get(job["name"])
                          or remembered.get(job["name"]))
        entry = state_projects.get(job["name"]) or {}
        if not job.get("harness_explicit") and entry.get("harness"):
            job["harness"] = check_harness(entry["harness"])
    for job in jobs:
        if job.get("cwd"):
            keep_source = job.get("fork") or job.get("record_latest")
            session_id = None if keep_source else job.get("resume")
            record_project(job["name"], job["cwd"], session_id, job.get("harness"))


async def live_cwds(results: list[dict]) -> None:
    try:
        sessions = await fetch_sessions()
    except Exception:
        return
    for result in results:
        info = sessions.get(result["name"]) or {}
        if info.get("cwd"):
            result["cwd"] = info["cwd"]


async def cmd_prompt(args) -> int:
    await ensure_server()
    job = normalize({"name": args.name, "cwd": args.cwd, "harness": args.harness,
                     "prompt": " ".join(args.text)}, True)
    await fill_cwds([job])
    if not job.get("cwd"):
        raise SystemExit(f"unknown project {job['name']!r}; "
                         "see bin/orch projects or pass --cwd")
    if args.session:
        job["resume"] = check_session_id(args.session)
        try:
            kind = airc_mods().load(job["harness"]).selector_kind(args.session)
        except (ValueError, NotImplementedError):
            kind = None
        if kind in ("name", "path"):
            job["record_latest"] = True
    elif args.resume and not await peer_present(job["name"]):
        session = latest_session(job["harness"], job["cwd"])
        if session:
            job["resume"] = session["session_id"]
    if args.fork:
        if not (job.get("resume") or job.get("continue")):
            raise SystemExit("--fork needs --resume or --session")
        job["fork"] = True
    result = await run_job(job, args.timeout, args.idle_exit, args.lock_wait, args.tools,
                           args.trust)
    await live_cwds([result])
    if args.json:
        print(json.dumps(result, indent=2))
    elif result["status"] == "turn_end":
        print(result["text"].strip())
    else:
        print(render_result(result, args.tools))
    return 0 if result["status"] == "turn_end" else (2 if result["status"] in ("timeout", "blocked") else 3)


async def cmd_fanout(args) -> int:
    await ensure_server()
    jobs = [normalize(entry, True) for entry in read_entries(args.file, "jobs")]
    await fill_cwds(jobs)
    unknown = [job["name"] for job in jobs if not job.get("cwd")]
    if unknown:
        raise SystemExit(f"unknown project(s): {', '.join(unknown)}; "
                         "see bin/orch projects or give each job a cwd")
    results = await asyncio.gather(
        *(run_job(job, args.timeout, args.idle_exit, args.lock_wait, args.tools, args.trust)
          for job in jobs))
    await live_cwds(results)
    if args.json:
        print(json.dumps(results, indent=2))
    else:
        print("\n\n".join(render_result(result, args.tools) for result in results))
    statuses = {result["status"] for result in results}
    return 0 if statuses == {"turn_end"} else (2 if statuses & {"timeout", "blocked"} else 3)


async def cmd_stop(args) -> int:
    name = check_name(args.name)
    if not await server_alive():
        proc = await asyncio.create_subprocess_exec(
            "tmux", "kill-session", "-t", f"ccb-{name}",
            stdout=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.DEVNULL)
        code = await proc.wait()
        print(f"server down; tmux kill-session ccb-{name} exit={code}")
        return 0 if code == 0 else 3
    async with aiohttp.ClientSession() as http:
        async with http.delete(base_url() + f"/sessions/{name}",
                               timeout=aiohttp.ClientTimeout(total=30)) as response:
            if response.status == 200:
                print(f"stopped {name}")
                return 0
            if response.status != 404:
                print(f"stop {name} failed: HTTP {response.status}")
                return 3
    proc = await asyncio.create_subprocess_exec(
        "tmux", "kill-session", "-t", f"ccb-{name}",
        stdout=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.DEVNULL)
    code = await proc.wait()
    print(f"no hub {name}; tmux kill-session ccb-{name} exit={code}")
    return 0 if code == 0 else 3


async def cmd_pane(args) -> int:
    pane = await capture(check_name(args.name))
    lines = [line.rstrip() for line in pane.splitlines() if line.strip()]
    for line in lines[-args.lines:]:
        print(line)
    return 0 if lines else 3


async def cmd_outputs(args) -> int:
    cwd = None
    if not args.all:
        cwd = project_target(args.name, None, None)["cwd"]
    rows = output_journal.scan(cwd=cwd, limit=args.limit)
    if args.json:
        print(json.dumps(rows, indent=2))
    else:
        for row in rows:
            print(f"{row['agent']}\t{row['session']}\t{row['last_kind']}\t"
                  f"{row['bytes']}\t{row['last_ts']}\t{row['path']}")
        print(f"{len(rows)} session outputs", file=sys.stderr)
    return 0 if rows else 3


async def cmd_output(args) -> int:
    cwd = None
    if args.name:
        cwd = project_target(args.name, None, None)["cwd"]
    row = output_journal.find_session(agent=args.agent, cwd=cwd, session_id=args.session)
    if row is None:
        raise SystemExit("no session output found")
    kinds = set(args.kind) if args.kind else None
    records = output_journal.tail_records(row["path"], args.tail, kinds=kinds)
    if args.json:
        print(json.dumps(records, indent=2))
    else:
        header = f"# {row['agent']} {row['session']} {row['path']}"
        print(output_journal.render_records(records, header=header))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="orch",
                                     description="Drive airc harness sessions as orchestrated peers")
    sub = parser.add_subparsers(dest="command", required=True)

    up = sub.add_parser("up", help="start the airc server if it is not running")
    up.set_defaults(func=cmd_up)

    down = sub.add_parser("down", help="stop the airc server and every session it owns")
    down.set_defaults(func=cmd_down)

    status = sub.add_parser("status", help="list live sessions with ready/busy state")
    status.add_argument("--json", action="store_true")
    status.add_argument("--panes", action="store_true")
    status.set_defaults(func=cmd_status)

    projects = sub.add_parser("projects", help="list projects in the parent path except this one")
    projects.add_argument("--all", action="store_true", help="include directories without a project marker")
    projects.add_argument("--json", action="store_true")
    projects.set_defaults(func=cmd_projects)

    start = sub.add_parser("start", help="start one or more named project peers")
    start.add_argument("names", nargs="*", metavar="NAME")
    start.add_argument("--cwd")
    start.add_argument("--harness", help="harness for the peer; defaults to the project's remembered harness")
    start.add_argument("--settle", type=float, default=3.0)
    start.add_argument("--concurrency", type=int, default=8)
    start.add_argument("--resume", action="store_true",
                       help="resume each project's latest session when it is not running")
    start.add_argument("--fork", action="store_true",
                       help="fork the resumed session instead of reusing its id")
    start.add_argument("--no-trust", dest="trust", action="store_false")
    start.set_defaults(func=cmd_start)

    prompt = sub.add_parser("prompt", help="start or prompt one session and wait for its turn")
    prompt.add_argument("name")
    prompt.add_argument("text", nargs="+")
    prompt.add_argument("--cwd")
    prompt.add_argument("--harness", help="harness for the peer; defaults to the project's remembered harness")
    prompt.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
    prompt.add_argument("--idle-exit", type=float, default=120.0)
    prompt.add_argument("--lock-wait", type=float, default=1800.0)
    prompt.add_argument("--tools", action="store_true")
    prompt.add_argument("--json", action="store_true")
    prompt.add_argument("--resume", action="store_true",
                        help="resume the project's latest session when it is not running")
    prompt.add_argument("--session", help="resume this harness session id before prompting")
    prompt.add_argument("--fork", action="store_true",
                        help="fork the resumed session instead of reusing its id")
    prompt.add_argument("--no-trust", dest="trust", action="store_false")
    prompt.set_defaults(func=cmd_prompt)

    fanout = sub.add_parser("fanout", help="prompt many sessions concurrently and collect answers")
    fanout.add_argument("file")
    fanout.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
    fanout.add_argument("--idle-exit", type=float, default=120.0)
    fanout.add_argument("--lock-wait", type=float, default=1800.0)
    fanout.add_argument("--tools", action="store_true")
    fanout.add_argument("--json", action="store_true")
    fanout.add_argument("--no-trust", dest="trust", action="store_false")
    fanout.set_defaults(func=cmd_fanout)

    resume = sub.add_parser("resume", help="resume a project's session; default is the last project")
    resume.add_argument("name", nargs="?", help="project name; omitted resumes the last project")
    resume.add_argument("--session", help="specific harness session id")
    resume.add_argument("--cwd", help="project directory when the name is not discovered")
    resume.add_argument("--continue", dest="continue_last", action="store_true",
                        help="use the harness's continue flag instead of a session id")
    resume.add_argument("--fork", action="store_true",
                        help="fork the session instead of reusing its id")
    resume.add_argument("--prompt", nargs="+", help="prompt to send after resuming")
    resume.add_argument("--harness", help="harness to resume; defaults to the project's remembered harness")
    resume.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
    resume.add_argument("--idle-exit", type=float, default=120.0)
    resume.add_argument("--lock-wait", type=float, default=1800.0)
    resume.add_argument("--settle", type=float, default=3.0)
    resume.add_argument("--tools", action="store_true")
    resume.add_argument("--json", action="store_true")
    resume.add_argument("--no-trust", dest="trust", action="store_false")
    resume.set_defaults(func=cmd_resume)

    sessions = sub.add_parser("sessions", help="list resumable harness sessions")
    sessions.add_argument("name", nargs="?", help="project name; omitted uses the last project")
    sessions.add_argument("--cwd", help="project directory when the name is not discovered")
    sessions.add_argument("--harness", help="harness to list; defaults to the project's remembered harness")
    sessions.add_argument("--all", action="store_true",
                          help="list sessions for every discovered project and harness")
    sessions.add_argument("--json", action="store_true")
    sessions.set_defaults(func=cmd_sessions)

    stop = sub.add_parser("stop", help="stop one session")
    stop.add_argument("name")
    stop.set_defaults(func=cmd_stop)

    pane = sub.add_parser("pane", help="print the tail of a session's terminal pane")
    pane.add_argument("name")
    pane.add_argument("--lines", type=int, default=40)
    pane.set_defaults(func=cmd_pane)

    outputs = sub.add_parser("outputs", help="list journaled session output files")
    outputs.add_argument("name", nargs="?", help="project name; omitted uses the last project")
    outputs.add_argument("--all", action="store_true")
    outputs.add_argument("--limit", type=int, default=50)
    outputs.add_argument("--json", action="store_true")
    outputs.set_defaults(func=cmd_outputs)

    output = sub.add_parser("output", help="read one journaled session output")
    output.add_argument("name", nargs="?", help="project name; omitted searches every project")
    output.add_argument("--agent")
    output.add_argument("--session")
    output.add_argument("--tail", type=int, default=40)
    output.add_argument("--kind", action="append")
    output.add_argument("--json", action="store_true")
    output.set_defaults(func=cmd_output)

    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        return asyncio.run(args.func(args))
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
