{
  "version": 3,
  "configurePresets": [
    {
      "name": "ship",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "x64-linux",
      "inherits": "ship",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "HYPERAGENT_STATIC_RUNTIME": "ON"
      }
    },
    {
      "name": "arm64-linux",
      "inherits": "ship",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-linux",
        "HYPERAGENT_STATIC_RUNTIME": "ON"
      }
    },
    {
      "name": "arm64-osx",
      "inherits": "ship",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "x64-osx",
      "inherits": "ship",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-osx"
      }
    }
  ]
}
