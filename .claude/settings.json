      "Bash(git -C * show*)",
      "Bash(git -C * ls-files*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gcloud logging read:*)",
      "Bash(gcloud * list*)",
      "Bash(gcloud * describe*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(node --check:*)"
