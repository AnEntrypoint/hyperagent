{
  "claudeMdExcludes": [
    "~/.claude/CLAUDE.md",
    "~/.claude/RTK.md"
  ],
  "enabledMcpjsonServers": [
    "hyperagent"
  ],
  "permissions": {
    "allow": [
      "CronCreate",
      "CronDelete",
      "CronList",
      "Read",
      "Write",
      "Edit",
      "Bash(bin/orch:*)",
      "Bash(./bin/orch:*)",
      "Bash(bin/watch:*)",
      "Bash(./bin/watch:*)",
      "Bash(python3 bin/orch:*)",
      "mcp__hyperagent__list_projects",
      "mcp__hyperagent__start_projects",
      "mcp__hyperagent__instruct",
      "mcp__hyperagent__instruct_many",
      "mcp__hyperagent__turn_result",
      "mcp__hyperagent__resume_project",
      "mcp__hyperagent__list_project_sessions",
      "mcp__hyperagent__list_outputs",
      "mcp__hyperagent__read_output",
      "mcp__hyperagent__search_output",
      "mcp__hyperagent__peer_status",
      "mcp__hyperagent__read_pane",
      "mcp__hyperagent__stop_peer",
      "mcp__hyperagent__server_down"
    ],
    "deny": []
  },
  "disableAllHooks": true,
  "enabledPlugins": {
    "cc-plugin-agents-md@builtin": false
  },
  "enableArtifact": false,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "remoteControlAtStartup": false,
  "autoMemoryDirectory": "/workspace/hyperagent/memories"
}
