      "Bash(date:*)",
      "Bash(pwd)",
      "Bash(free:*)",
      "Bash(vmstat:*)",
      "Bash(uptime)",
      "Bash(df:*)",
      "Bash(du:*)",
      "Bash(ps:*)",
      "Bash(pgrep:*)",
      "Bash(stat:*)",
      "Bash(which:*)",
      "Bash(jq:*)",
      "Bash(diff:*)",
      "Bash(sed -n:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git fetch:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git -C * status*)",
